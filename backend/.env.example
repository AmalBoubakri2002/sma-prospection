DATABASE_URL=postgresql+asyncpg://sma_user:sma_password@localhost:5433/sma_db
SECRET_KEY=change_me_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
DEBUG=true

# Clé API SIRENE (INSEE) — portail-api.insee.fr, header X-INSEE-Api-Key-Integration
INSEE_API_KEY=

# Agent Enrichissement — API officielle gratuite, sans clé requise
# recherche-entreprises.api.gouv.fr utilisé directement, aucune config supplémentaire

# INPI RNE — comptes annuels (fallback CA/résultat net). Compte gratuit sur
# data.inpi.fr, puis "Mes accès API" > "Accès API RNE". Pas de clé statique :
# authentification par login (voir app/agents/enrichissement/inpi.py).
INPI_USERNAME=
INPI_PASSWORD=

# CRM Odoo 17 — identifiants applicatifs (créés via l'assistant web lors de
# la 1re initialisation de la base, cf. docker-compose.yml service "odoo").
ODOO_URL=http://localhost:8069
ODOO_DB=odoo
ODOO_USERNAME=
ODOO_PASSWORD=

# Secret partagé des webhooks Odoo → backend (POST /api/v1/webhooks/odoo).
# Générer une valeur aléatoire (ex : openssl rand -hex 32) et renseigner la
# MÊME valeur dans Odoo : Paramètres > Technique > Paramètres système >
# sma_pc.webhook_secret. Vide = endpoint fermé (503).
ODOO_WEBHOOK_SECRET=
