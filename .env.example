# ─── PostgreSQL ───────────────────────────────────────────
POSTGRES_USER=sma_user
POSTGRES_PASSWORD=sma_password
POSTGRES_DB=sma_db
DATABASE_URL=postgresql+asyncpg://sma_user:sma_password@localhost:5432/sma_db

# ─── Backend ──────────────────────────────────────────────
SECRET_KEY=change_me_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_CORS_ORIGINS=http://localhost:5173

# ─── LLM ──────────────────────────────────────────────────
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-large-latest

# ─── Odoo CRM ─────────────────────────────────────────────
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=odoo

ODOO_URL=http://localhost:8069
ODOO_DB=odoo
ODOO_USERNAME=admin@sma-prospection.local
ODOO_PASSWORD=admin

# ─── LangSmith (observabilité) ────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=sma-prospection

# ─── API SIRENE (INSEE) ───────────────────────────────────
INSEE_API_KEY=your_insee_api_key_here
